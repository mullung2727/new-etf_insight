<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>One-off KRX 1-minute bar backfill for 2025-10, daily 20:00 up to 240 min until complete (2026-10-16)</Description>
    <URI>\new-etf_insight\minute-bars-backfill-202510</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-10-16T20:00:00</StartBoundary>
