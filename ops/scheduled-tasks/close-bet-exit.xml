<?xml version="1.0"?>
<!-- Windows 작업 스케줄러 정의 — 종가베팅 청산 워커 (장중 3초 폴링)
     파라미터 변경: Arguments 수정 후 아래 명령으로 재등록
       Register-ScheduledTask -Xml (Get-Content -Path close-bet-exit.xml -Raw -Encoding UTF8) -TaskName "close-bet-exit" -TaskPath "\OpenClaw\" -Force
     매 기동마다 DB+잔고에서 watch set 재부팅(stateless) → RestartOnFailure로 크래시 자동복구.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>종가베팅 청산 워커 (평일 08:50 기동, +5% 익절/-3% 손절, 15:19 강제청산, 15:25 종료)</Description>
    <URI>\OpenClaw\close-bet-exit</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-06-16T08:50:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT7H</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>5</Count>
    </RestartOnFailure>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -File "C:\Users\mullu\.openclaw\workspace\etl\new-etf_insight\ops\scheduled-tasks\run-close-bet-exit.ps1"</Arguments>
    </Exec>
  </Actions>
</Task>
