{
  "schemaVersion": 1,
  "owner": "new-etf_insight",
  "description": "Project-owned batch registry. Windows Task Scheduler is the primary executor for production batches; OpenClaw cron specs are kept as legacy/fallback metadata. Report delivery channel is NOT set per-job here — it is controlled globally by NOTIFY_CHANNEL in .env (default discord); see etl/scripts/notify.py to switch or add channels. windowsTask.delivery below records the default channel's env only.",
  "defaults": {
    "agentId": "main",
    "sessionTarget": "isolated",
    "wakeMode": "now",
    "payloadKind": "agentTurn",
    "delivery": {
      "mode": "announce",
      "channel": "discord",
      "to": "1513799139715190854"
    },
    "fileReadingRule": "Read batch instruction files and Korean report bodies with a platform-neutral UTF-8-safe reader, such as OpenClaw file_fetch or native workspace file access. Do not use host-default shell decoding such as Windows PowerShell 5.1 Get-Content without explicit UTF-8 handling. If Korean text appears corrupted, discard that read result and reread with a UTF-8-safe reader before composing the Discord report."
  },
  "jobs": [
    {
      "id": "51ed51c4-41a1-4977-b65f-f5d603e76eed",
