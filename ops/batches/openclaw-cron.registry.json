      "enabled": false,
      "schedule": {
        "kind": "cron",
        "expr": "10 15 * * 1-5",
        "tz": "Asia/Seoul"
      },
      "instructionFile": "ops/batches/daily-etf-watchlist-intraday-kiwoom.md",
      "timeoutSeconds": 7200,
      "windowsTask": {
        "enabled": true,
        "taskPath": "\\new-etf_insight\\",
        "taskName": "daily-etf-watchlist-intraday-kiwoom",
        "xmlFile": "ops/scheduled-tasks/watchlist-intraday.xml",
        "runnerScript": "ops/scheduled-tasks/run-watchlist-intraday.ps1",
        "delivery": {
          "kind": "discordWebhook",
          "env": "DISCORD_WEBHOOK_URL"
        }
      },
      "delivery": {
        "mode": "announce",
        "channel": "discord",
        "to": "1513799139715190854"
      }
    },
