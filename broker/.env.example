# Kiwoom REST API broker MCP — env config
# 이 저장소는 루트 .env 하나만 쓴다. broker/.env 는 만들지 않는다.
# NEVER commit .env (see .gitignore).

# paper = 모의투자 (mockapi.kiwoom.com), real = 실전 (api.kiwoom.com)
# 프로세스 시작 시 고정된다. 런타임 전환 API·UI 는 없다 — 바꾸려면 이 값을 고치고 재기동.
KIWOOM_ENV=paper

# 자격증명은 환경별로 따로 둔다. KIWOOM_ENV 값에 따라 PAPER_ / REAL_ 쪽을 읽으므로
# 위 한 줄만 바꾸면 주소·키·계좌가 통째로 같이 움직인다("실전 주소 + 모의 키" 방지).
# 모의/실전 앱키는 https://openapi.kiwoom.com 에서 각각 따로 발급받는다.
KIWOOM_PAPER_APPKEY=
KIWOOM_PAPER_SECRETKEY=
KIWOOM_PAPER_ACCOUNT_NO=

KIWOOM_REAL_APPKEY=
KIWOOM_REAL_SECRETKEY=
KIWOOM_REAL_ACCOUNT_NO=

# Order guard — 1회 주문 최대 금액(원). guards.check_order 에서 강제.
# 지정가는 price*qty, 시장가 매수는 현재가*qty 로 검사한다(시장가 매도는 면제).
# 전략 예산보다 반드시 크게 잡을 것 — 낮으면 정상 주문이 거부된다.
MAX_ORDER_AMOUNT=1000000

# Optional: where to cache the access token between runs.
TOKEN_CACHE_PATH=.token_cache.json
