# Kiwoom REST API broker MCP — env config
# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# App credentials from https://openapi.kiwoom.com (모의투자/실전 each have own keys)
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=

# paper = 모의투자 (mockapi.kiwoom.com), real = 실전 (api.kiwoom.com)
# Default paper for safety. Switch to real only after validation.
KIWOOM_ENV=paper

# Account number for orders/balance (계좌번호). 모의투자 계좌 for paper.
KIWOOM_ACCOUNT_NO=

# Order guards — reject orders exceeding these (placed in orders.place_order).
# MAX_ORDER_AMOUNT: max price*qty (KRW) per single order.
# MAX_ORDER_QTY: max shares per single order.
MAX_ORDER_AMOUNT=1000000
MAX_ORDER_QTY=100

# Optional: where to cache the access token between runs.
TOKEN_CACHE_PATH=.token_cache.json
