{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticker", "name", "target", "probability_score", "score_components", "confidence",
    "up_factors", "down_factors", "news_summary", "telegram_summary",
    "reasoning", "evidence_quality"
  ],
  "properties": {
    "ticker": {"type": "string"},
    "name": {"type": "string"},
    "target": {"type": "string", "const": "D+1_OPEN_ABOVE_D_CLOSE"},
    "probability_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "score_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalyst_strength", "freshness", "confirmation", "negative_event_risk",
        "negative_trend_penalty",
        "priced_in_level", "priced_in_penalty", "exhaustion_level", "exhaustion_penalty"
      ],
      "properties": {
        "catalyst_strength": {"type": "integer", "minimum": 0, "maximum": 30},
        "freshness": {"type": "integer", "minimum": 0, "maximum": 10},
        "confirmation": {"type": "integer", "minimum": 0, "maximum": 5},
        "negative_event_risk": {"type": "integer", "minimum": 0, "maximum": 20},
        "negative_trend_penalty": {"type": "integer", "minimum": 0, "maximum": 15},
        "priced_in_level": {"type": "string", "enum": ["unknown", "low", "medium", "high"]},
        "priced_in_penalty": {"type": "integer", "minimum": 0, "maximum": 20},
        "exhaustion_level": {"type": "string", "enum": ["unknown", "low", "medium", "high"]},
        "exhaustion_penalty": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "up_factors": {"type": "array", "items": {"type": "string"}},
    "down_factors": {"type": "array", "items": {"type": "string"}},
    "news_summary": {"type": "string"},
    "telegram_summary": {"type": "string"},
    "reasoning": {"type": "string"},
    "evidence_quality": {"type": "string", "enum": ["weak", "moderate", "strong"]}
  }
}
