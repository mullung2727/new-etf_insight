# FastAPI backend env config
# Path to the SQLite file produced by etl/scripts/build_db.py.
# (Var name kept as DUCKDB_PATH for back-compat; the file is now SQLite.)
# Default assumes api/ and etl/ are siblings under the repo root.
DUCKDB_PATH=../etl/db/etf_insight.sqlite3

# Watchlist batch outputs (build_watchlist.py etc.) — SQLite, opened query_only per request.
WATCHLIST_DB_PATH=../etl/db/watchlist.sqlite3
# OHLCV cache stays DuckDB (OLAP aggregation).
KRX_DB_PATH=../etl/db/krx_ohlcv.duckdb

# Comma-separated list of allowed CORS origins.
# In production add the Vercel deploy URL here.
CORS_ORIGINS=http://localhost:3000
