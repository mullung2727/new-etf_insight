# FastAPI backend env config
# Path to the DuckDB file produced by etl/scripts/build_db.py.
# Default assumes api/ and etl/ are siblings under the repo root.
DUCKDB_PATH=../etl/db/etf_insight.duckdb

# Comma-separated list of allowed CORS origins.
# In production add the Vercel deploy URL here.
CORS_ORIGINS=http://localhost:3000
