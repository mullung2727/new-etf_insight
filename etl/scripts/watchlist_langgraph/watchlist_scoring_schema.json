{
  "$defs": {
    "theme_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "score"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "score": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "catalyst": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label", "description", "category_raw", "status", "expected_duration",
        "alive_score", "reason", "invalidation", "evidence_refs"
      ],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "category_raw": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["alive", "uncertain", "exhausted"]},
        "expected_duration": {
          "type": "string",
          "enum": ["intraday", "two_to_five_trading_days", "one_week_or_more", "unknown"]
        },
        "alive_score": {"type": "integer", "minimum": 1, "maximum": 5},
        "reason": {"type": "string", "minLength": 1},
        "invalidation": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ticker", "name", "target", "probability_score", "score_components", "confidence",
    "up_factors", "down_factors", "news_summary", "telegram_summary",
    "reasoning", "evidence_quality", "primary_catalyst", "secondary_catalysts",
    "theme_scores", "theme_event_direction", "new_theme_candidate"
  ],
  "properties": {
    "ticker": {"type": "string"},
    "name": {"type": "string"},
    "target": {"type": "string", "const": "D+1_OPEN_ABOVE_D_CLOSE"},
    "probability_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "score_components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalyst_strength", "freshness", "confirmation", "negative_event_risk",
        "negative_trend_penalty",
        "priced_in_level", "priced_in_penalty", "exhaustion_level", "exhaustion_penalty"
      ],
      "properties": {
        "catalyst_strength": {"type": "integer", "minimum": 0, "maximum": 30},
        "freshness": {"type": "integer", "minimum": 0, "maximum": 10},
        "confirmation": {"type": "integer", "minimum": 0, "maximum": 5},
        "negative_event_risk": {"type": "integer", "minimum": 0, "maximum": 20},
        "negative_trend_penalty": {"type": "integer", "minimum": 0, "maximum": 15},
        "priced_in_level": {"type": "string", "enum": ["unknown", "none", "low", "medium", "high"]},
        "priced_in_penalty": {"type": "integer", "minimum": 0, "maximum": 20},
        "exhaustion_level": {"type": "string", "enum": ["unknown", "low", "medium", "high"]},
        "exhaustion_penalty": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "up_factors": {"type": "array", "items": {"type": "string"}},
    "down_factors": {"type": "array", "items": {"type": "string"}},
    "news_summary": {"type": "string"},
    "telegram_summary": {"type": "string"},
    "reasoning": {"type": "string"},
    "evidence_quality": {"type": "string", "enum": ["weak", "moderate", "strong"]},
    "primary_catalyst": {"$ref": "#/$defs/catalyst"},
    "secondary_catalysts": {
      "type": "array",
      "items": {"$ref": "#/$defs/catalyst"}
    },
    "theme_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sector", "event"],
      "properties": {
        "sector": {"type": "array", "items": {"$ref": "#/$defs/theme_score"}},
        "event": {"type": "array", "items": {"$ref": "#/$defs/theme_score"}}
      }
    },
    "theme_event_direction": {
      "type": "string",
      "enum": ["positive", "negative", "neutral"]
    },
    "new_theme_candidate": {"type": ["string", "null"]}
  }
}
