{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "is_pre_listing_etf",
    "fund_name",
    "asset_manager",
    "index",
    "market_exposure",
    "theme_classification",
    "holdings",
    "keywords",
    "trend_summary",
    "missing_info"
  ],
  "properties": {
    "is_pre_listing_etf": {
      "type": "boolean"
    },
    "fund_name": {
      "type": ["string", "null"]
    },
    "asset_manager": {
      "type": ["string", "null"]
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provider", "description"],
      "properties": {
        "name": {
          "type": ["string", "null"]
        },
        "provider": {
          "type": ["string", "null"]
        },
        "description": {
          "type": ["string", "null"]
        }
      }
    },
    "market_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_country", "evidence"],
      "properties": {
        "primary_country": {
          "type": "string",
          "enum": ["KR", "US", "CN", "HK", "JP", "IN", "VN", "GLOBAL", "MIXED", "UNKNOWN"]
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "theme_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme_status", "theme_bucket", "structure_tags", "confidence", "evidence"],
      "properties": {
        "theme_status": {
          "type": "string",
          "enum": ["theme", "mixed", "non_theme", "unknown"]
        },
        "theme_bucket": {
          "type": "string",
          "enum": [
            "technology",
            "energy_materials",
            "healthcare",
            "industrial_defense",
            "consumer_demographic",
            "finance_income",
            "country_macro",
            "digital_asset",
            "none",
            "unknown"
          ]
        },
        "structure_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "active",
              "passive",
              "single_stock",
              "covered_call",
              "leveraged_inverse",
              "bond_mixed",
              "monthly_distribution",
              "currency_hedged"
            ]
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "holdings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available_in_pdf", "summary", "items", "where_to_find_more"],
      "properties": {
        "available_in_pdf": {
          "type": "boolean"
        },
        "summary": {
          "type": ["string", "null"]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "ticker", "exchange", "weight"],
            "properties": {
              "name": {
                "type": "string"
              },
              "ticker": {
                "type": ["string", "null"]
              },
              "exchange": {
                "type": ["string", "null"]
              },
              "weight": {
                "type": ["string", "number", "null"]
              }
            }
          }
        },
        "where_to_find_more": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trend_summary": {
      "type": ["string", "null"]
    },
    "missing_info": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
