{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route",
    "summary",
    "research_prompt"
  ],
  "properties": {
    "route": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_pre_listing_etf",
        "fund_name",
        "asset_manager",
        "index",
        "market_exposure",
        "holdings",
        "keywords",
        "trend_summary",
        "missing_info"
      ],
      "properties": {
        "is_pre_listing_etf": {
          "type": "boolean"
        },
        "fund_name": {
          "type": ["string", "null"]
        },
        "asset_manager": {
          "type": ["string", "null"]
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "provider", "description"],
          "properties": {
            "name": {
              "type": ["string", "null"]
            },
            "provider": {
              "type": ["string", "null"]
            },
            "description": {
              "type": ["string", "null"]
            }
          }
        },
        "market_exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_country", "evidence"],
          "properties": {
            "primary_country": {
              "type": "string",
              "enum": ["KR", "US", "CN", "HK", "JP", "IN", "VN", "GLOBAL", "MIXED", "UNKNOWN"]
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "holdings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available_in_pdf", "summary", "items", "where_to_find_more"],
          "properties": {
            "available_in_pdf": {
              "type": "boolean"
            },
            "summary": {
              "type": ["string", "null"]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "ticker", "exchange", "weight"],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "ticker": {
                    "type": ["string", "null"]
                  },
                  "exchange": {
                    "type": ["string", "null"]
                  },
                  "weight": {
                    "type": ["string", "number", "null"]
                  }
                }
              }
            },
            "where_to_find_more": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trend_summary": {
          "type": ["string", "null"]
        },
        "missing_info": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "research_prompt": {
      "type": "string"
    }
  }
}
